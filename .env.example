USHAGENT_TELEGRAM_BOT_TOKEN=123456789:AA_your_bot_token_here

# Optional: alternate name also supported
# TELEGRAM_BOT_TOKEN=123456789:AA_your_bot_token_here

# Optional: override the cloudflared binary used for phone onboarding
# USHAGENT_CLOUDFLARED_BIN=/usr/local/bin/cloudflared
# HEYAGENT_CLOUDFLARED_BIN=/usr/local/bin/cloudflared

# Optional: point UshAgent at a different env file
# USHAGENT_ENV_FILE=/absolute/path/to/.env
# HEYAGENT_ENV_FILE=/absolute/path/to/.env
